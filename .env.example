# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored -- never commit real values.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Your GreenGeeks cPanel hostname. Either the server hostname from your
# GreenGeeks welcome email, or your own domain if it points at the server.
# No https://, no port.
CPANEL_HOST=yourdomain.com

# cPanel SSL port. GreenGeeks uses 2083; you should not need to change this.
CPANEL_PORT=2083

# Your cPanel username (cPanel > top-right > General Information).
CPANEL_USER=yourcpaneluser

# A cPanel API TOKEN -- not your cPanel password.
# Create at: cPanel > Security > Manage API Tokens > Create.
CPANEL_TOKEN=paste-your-api-token-here

# Absolute path of the repository ON THE SERVER, exactly as shown in
# cPanel > Git Version Control. Usually /home/<cpaneluser>/repositories/<repo>.
CPANEL_REPO_ROOT=/home/yourcpaneluser/repositories/Test

# Branch that gets deployed.
DEPLOY_BRANCH=main
