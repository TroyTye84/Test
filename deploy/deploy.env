# ---------------------------------------------------------------------------
# Server-side deployment settings.
# This file is read by deploy/remote-deploy.sh ON THE GREENGEEKS SERVER.
# It contains no secrets, so it is safe to commit.
# ---------------------------------------------------------------------------

# Where the site is published. $HOME is your GreenGeeks account home
# (e.g. /home/yourusername), so this resolves to /home/yourusername/public_html.
#
# For an addon/subdomain, point it at that docroot instead, e.g.:
#   DEPLOY_PATH="$HOME/public_html/staging"
DEPLOY_PATH="$HOME/public_html"

# Directory in the repo whose CONTENTS become the contents of DEPLOY_PATH.
SOURCE_DIR="public_html"

# Delete files on the server that no longer exist in the repo.
# Start with "false". Turn this on only once you are confident that everything
# in DEPLOY_PATH is managed by this repo -- otherwise it will remove files that
# were uploaded by hand, by WordPress, or by cPanel.
DELETE_REMOVED="false"

# Paths never touched by a deploy, even when DELETE_REMOVED=true.
# One pattern per line, relative to DEPLOY_PATH. rsync exclude syntax.
PROTECTED_PATHS="
.well-known/
cgi-bin/
wp-content/uploads/
.htaccess.local
"

# Permissions applied after sync. GreenGeeks (like most cPanel hosts) runs
# PHP under your own user, so 755/644 is correct. Do not use 777.
DIR_MODE="755"
FILE_MODE="644"
